# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# 打包产物（APK / Windows 安装包 / 免安装压缩包）只作为发布附件，不进版本库
/dist/
*.apk
*.aab
*.exe
*.msi
*.zip

# Android 签名材料：绝对不要入库（模板已忽略 key.properties 与 *.jks/*.keystore）
/android/key.properties
/android/app/*.jks
/android/app/*.keystore
/android/app/upload-keystore.jks

# Inno Setup 编译中间产物
/dist/**/*.tmp
*.iss.bak

# 本机数据库/日志（跑真机或集成测试时会生成）
*.anki2
*.anki2-journal
*.anki2-wal
*.anki2.migrated
*.db
*.db-journal
word_cards.db
